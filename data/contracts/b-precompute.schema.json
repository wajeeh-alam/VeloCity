{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "velocity.b-precompute.v2"
    },
    "coordinateReferenceSystem": {
      "const": "EPSG:4326"
    },
    "dataStatus": {
      "const": "osm-routing-analysis"
    },
    "checksums": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "osm": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "flows": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidates": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceManifest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "demand": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "demandPath": {
          "type": "string"
        }
      },
      "required": [
        "network",
        "osm",
        "flows",
        "candidates",
        "sourceManifest"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "osm": {
          "type": "string"
        },
        "osmSnapshot": {
          "type": "string"
        },
        "snapshotManifest": {
          "const": "data/b-source/v1/manifest.json"
        },
        "snapshotLicense": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "url",
        "osm",
        "osmSnapshot",
        "snapshotManifest",
        "snapshotLicense"
      ],
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 1
        },
        "edges": {
          "type": "integer",
          "minimum": 1
        },
        "exclusions": {
          "type": "object",
          "properties": {
            "forbiddenWays": {
              "type": "number",
              "minimum": 0
            },
            "directionalWays": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "forbiddenWays",
            "directionalWays"
          ],
          "additionalProperties": false
        },
        "stressEvidence": {
          "type": "object",
          "properties": {
            "osmLowStressEdges": {
              "type": "number",
              "minimum": 0
            },
            "torontoEnrichedEdges": {
              "type": "number",
              "minimum": 0
            },
            "highStressEdges": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "osmLowStressEdges",
            "torontoEnrichedEdges",
            "highStressEdges"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodes",
        "edges",
        "exclusions",
        "stressEvidence"
      ],
      "additionalProperties": false
    },
    "observationPeriod": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 8
    },
    "demandStatus": {
      "enum": [
        "validated",
        "blocked"
      ]
    },
    "demandErrors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "networks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "corridorId": {
            "type": "string"
          },
          "candidateStatus": {
            "enum": [
              "synthetic-fixture",
              "exploratory-unverified",
              "plan-backed-source"
            ]
          },
          "status": {
            "enum": [
              "ready",
              "blocked"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accounting": {
            "type": "object",
            "properties": {
              "publishedTrips": {
                "type": "integer",
                "minimum": 0
              },
              "outsideWindowTrips": {
                "type": "integer",
                "minimum": 0
              },
              "sameNodeTrips": {
                "type": "integer",
                "minimum": 0
              },
              "disconnectedTrips": {
                "type": "integer",
                "minimum": 0
              },
              "cappedTrips": {
                "type": "integer",
                "minimum": 0
              },
              "retainedTrips": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "publishedTrips",
              "outsideWindowTrips",
              "sameNodeTrips",
              "disconnectedTrips",
              "cappedTrips",
              "retainedTrips"
            ],
            "additionalProperties": false
          },
          "coverage": {
            "type": "object",
            "properties": {
              "connectedFraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "retainedFraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "retainedOdPairs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 24
              }
            },
            "required": [
              "connectedFraction",
              "retainedFraction",
              "retainedOdPairs"
            ],
            "additionalProperties": false
          },
          "match": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "edgeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true,
                    "minItems": 1
                  },
                  "endpointSnapMetres": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "pathMetres": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "edgeIds",
                  "endpointSnapMetres",
                  "pathMetres"
                ],
                "additionalProperties": false
              }
            ]
          },
          "partitions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "partitionId": {
                  "type": "string"
                },
                "tripCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "network": {
                  "type": "object",
                  "properties": {
                    "schemaVersion": {
                      "const": "velocity.simulation-network.v1"
                    },
                    "coordinateReferenceSystem": {
                      "const": "EPSG:4326"
                    },
                    "version": {
                      "type": "string"
                    },
                    "sourceName": {
                      "type": "string"
                    },
                    "sourceUrl": {
                      "type": "string"
                    },
                    "isIllustrative": {
                      "type": "boolean"
                    },
                    "nodes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "longitude": {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          "latitude": {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          },
                          "population": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "destinations": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "id",
                          "longitude",
                          "latitude",
                          "population",
                          "destinations"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 2,
                      "maxItems": 48
                    },
                    "edges": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "from": {
                            "type": "string"
                          },
                          "to": {
                            "type": "string"
                          },
                          "minutes": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "highStress": {
                            "type": "boolean"
                          },
                          "corridorId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "from",
                          "to",
                          "minutes",
                          "highStress"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1,
                      "maxItems": 128
                    },
                    "flows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "from": {
                            "type": "string"
                          },
                          "to": {
                            "type": "string"
                          },
                          "corridorId": {
                            "type": "string"
                          },
                          "weight": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "id",
                          "from",
                          "to",
                          "corridorId",
                          "weight"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1,
                      "maxItems": 64
                    },
                    "accessibilityMinutes": {
                      "type": "number",
                      "minimum": 0
                    },
                    "stressPenalty": {
                      "type": "number",
                      "minimum": 0
                    },
                    "maxLowStressDetourRatio": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "coordinateReferenceSystem",
                    "version",
                    "sourceName",
                    "sourceUrl",
                    "isIllustrative",
                    "nodes",
                    "edges",
                    "flows",
                    "accessibilityMinutes",
                    "stressPenalty",
                    "maxLowStressDetourRatio"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "partitionId",
                "tripCount",
                "network"
              ],
              "additionalProperties": false
            },
            "maxItems": 24
          }
        },
        "required": [
          "corridorId",
          "candidateStatus",
          "status",
          "errors",
          "accounting",
          "coverage",
          "match",
          "partitions"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              }
            },
            "then": {
              "properties": {
                "errors": {
                  "maxItems": 0,
                  "type": "array"
                },
                "partitions": {
                  "minItems": 3,
                  "type": "array"
                },
                "match": {
                  "type": "object"
                }
              }
            },
            "else": {
              "properties": {
                "errors": {
                  "minItems": 1,
                  "type": "array"
                },
                "partitions": {
                  "maxItems": 0,
                  "type": "array"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "portfolio": {
      "type": "object",
      "properties": {
        "dataStatus": {
          "const": "routing-ready-only"
        },
        "years": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "horizonYear": {
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "builtCorridorIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "activeCorridorIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "horizonYear",
              "builtCorridorIds",
              "activeCorridorIds"
            ],
            "additionalProperties": false
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rankedCorridorIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "unbuiltCorridorIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "corridorId": { "type": "string" },
              "reasons": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            },
            "required": ["corridorId", "reasons"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "dataStatus",
        "years",
        "rankedCorridorIds",
        "unbuiltCorridorIds",
        "warnings",
        "excludedCandidates"
      ],
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "corridorId": {
            "type": "string"
          },
          "candidateStatus": {
            "enum": [
              "synthetic-fixture",
              "exploratory-unverified",
              "plan-backed-source"
            ]
          },
          "status": {
            "enum": [
              "blocked",
              "precomputed"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "simulations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "partitionId": {
                  "type": "string"
                },
                "simulation": {
                  "type": "object",
                  "properties": {
                    "before": {
                      "type": "object",
                      "properties": {
                        "lowStressTrips": {
                          "type": "number",
                          "minimum": 0
                        },
                        "populationConnected": {
                          "type": "number",
                          "minimum": 0
                        },
                        "destinationsReached": {
                          "type": "number",
                          "minimum": 0
                        },
                        "dangerousSegments": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "lowStressTrips",
                        "populationConnected",
                        "destinationsReached",
                        "dangerousSegments"
                      ],
                      "additionalProperties": false
                    },
                    "after": {
                      "type": "object",
                      "properties": {
                        "lowStressTrips": {
                          "type": "number",
                          "minimum": 0
                        },
                        "populationConnected": {
                          "type": "number",
                          "minimum": 0
                        },
                        "destinationsReached": {
                          "type": "number",
                          "minimum": 0
                        },
                        "dangerousSegments": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "lowStressTrips",
                        "populationConnected",
                        "destinationsReached",
                        "dangerousSegments"
                      ],
                      "additionalProperties": false
                    },
                    "routes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "flowId": {
                            "type": "string"
                          },
                          "weight": {
                            "type": "number",
                            "minimum": 0
                          },
                          "before": {
                            "type": "object",
                            "properties": {
                              "edgeIds": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "uniqueItems": true
                              },
                              "nodeIds": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "uniqueItems": true
                              },
                              "minutes": {
                                "type": "number",
                                "minimum": 0
                              },
                              "highStressEdges": {
                                "type": "number",
                                "minimum": 0
                              },
                              "coordinateReferenceSystem": {
                                "const": "EPSG:4326"
                              },
                              "coordinates": {
                                "type": "array",
                                "items": {
                                  "type": "array",
                                  "items": {
                                    "type": "number"
                                  },
                                  "minItems": 2,
                                  "maxItems": 2
                                }
                              },
                              "path": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "edgeIds",
                              "nodeIds",
                              "minutes",
                              "highStressEdges",
                              "coordinateReferenceSystem",
                              "coordinates",
                              "path"
                            ],
                            "additionalProperties": false
                          },
                          "after": {
                            "type": "object",
                            "properties": {
                              "edgeIds": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "uniqueItems": true
                              },
                              "nodeIds": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "uniqueItems": true
                              },
                              "minutes": {
                                "type": "number",
                                "minimum": 0
                              },
                              "highStressEdges": {
                                "type": "number",
                                "minimum": 0
                              },
                              "coordinateReferenceSystem": {
                                "const": "EPSG:4326"
                              },
                              "coordinates": {
                                "type": "array",
                                "items": {
                                  "type": "array",
                                  "items": {
                                    "type": "number"
                                  },
                                  "minItems": 2,
                                  "maxItems": 2
                                }
                              },
                              "path": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "edgeIds",
                              "nodeIds",
                              "minutes",
                              "highStressEdges",
                              "coordinateReferenceSystem",
                              "coordinates",
                              "path"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "flowId",
                          "weight",
                          "before",
                          "after"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "networkState": {
                      "type": "object",
                      "properties": {
                        "horizonYear": {
                          "enum": [
                            1,
                            2,
                            3
                          ]
                        },
                        "activeCorridorIds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "horizonYear",
                        "activeCorridorIds"
                      ],
                      "additionalProperties": false
                    },
                    "networkProvenance": {
                      "type": "object",
                      "properties": {
                        "version": {
                          "type": "string"
                        },
                        "sourceName": {
                          "type": "string"
                        },
                        "sourceUrl": {
                          "type": "string"
                        },
                        "coordinateReferenceSystem": {
                          "const": "EPSG:4326"
                        },
                        "isIllustrative": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "version",
                        "sourceName",
                        "sourceUrl",
                        "coordinateReferenceSystem",
                        "isIllustrative"
                      ],
                      "additionalProperties": false
                    },
                    "agents": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "scoring": {
                      "type": "object"
                    },
                    "mode": {
                      "const": "trained-artifact"
                    },
                    "artifactId": {
                      "type": "string"
                    },
                    "demand": {
                      "type": "object",
                      "properties": {
                        "prediction": {
                          "type": "number",
                          "minimum": 0
                        },
                        "lower": {
                          "type": "number",
                          "minimum": 0
                        },
                        "upper": {
                          "type": "number",
                          "minimum": 0
                        },
                        "unit": {
                          "const": "dimensionless-relative-hourly-demand"
                        }
                      },
                      "required": [
                        "prediction",
                        "lower",
                        "upper",
                        "unit"
                      ],
                      "additionalProperties": false
                    },
                    "metricDefinitions": {
                      "type": "object"
                    },
                    "disclaimer": {
                      "type": "string"
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "before",
                    "after",
                    "routes",
                    "networkState",
                    "networkProvenance",
                    "agents",
                    "scoring",
                    "mode",
                    "artifactId",
                    "demand",
                    "metricDefinitions",
                    "disclaimer",
                    "warnings"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "partitionId",
                "simulation"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "corridorId",
          "candidateStatus",
          "status",
          "blockers",
          "simulations"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "precomputed"
                }
              }
            },
            "then": {
              "properties": {
                "blockers": {
                  "maxItems": 0,
                  "type": "array"
                },
                "simulations": {
                  "minItems": 3,
                  "type": "array"
                }
              }
            },
            "else": {
              "properties": {
                "blockers": {
                  "minItems": 1,
                  "type": "array"
                },
                "simulations": {
                  "maxItems": 0,
                  "type": "array"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "coordinateReferenceSystem",
    "dataStatus",
    "checksums",
    "source",
    "graph",
    "observationPeriod",
    "assumptions",
    "demandStatus",
    "demandErrors",
    "networks",
    "portfolio",
    "scenarios"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "demandStatus": {
            "const": "validated"
          }
        }
      },
      "then": {
        "properties": {
          "demandErrors": {
            "maxItems": 0,
            "type": "array"
          }
        }
      },
      "else": {
        "properties": {
          "demandErrors": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
