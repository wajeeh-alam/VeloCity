{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velocity.local/contracts/corridors.schema.json",
  "title": "VeloCity corridor evidence",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "schema_version": { "const": "1.0.0" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "geometry", "properties"],
        "properties": {
          "type": { "const": "Feature" },
          "id": { "type": "string" },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "enum": ["LineString", "MultiLineString"] },
              "coordinates": { "type": "array", "minItems": 2 }
            }
          },
          "properties": {
            "type": "object",
            "required": ["corridor_id", "name", "candidate_type", "scores", "mean_score", "strong_input_count", "rating", "data_status"],
            "properties": {
              "corridor_id": { "type": "string" },
              "name": { "type": "string" },
              "candidate_type": { "enum": ["plan_backed", "exploratory"] },
              "scores": {
                "type": "object",
                "required": ["safety", "connectivity", "equity_population", "current_demand", "potential_demand", "transit", "barriers", "coverage", "destinations"],
                "additionalProperties": false,
                "properties": {
                  "safety": { "$ref": "#/$defs/score" },
                  "connectivity": { "$ref": "#/$defs/score" },
                  "equity_population": { "$ref": "#/$defs/score" },
                  "current_demand": { "$ref": "#/$defs/score" },
                  "potential_demand": { "$ref": "#/$defs/score" },
                  "transit": { "$ref": "#/$defs/score" },
                  "barriers": { "$ref": "#/$defs/score" },
                  "coverage": { "$ref": "#/$defs/score" },
                  "destinations": { "$ref": "#/$defs/score" }
                }
              },
              "mean_score": { "$ref": "#/$defs/score" },
              "strong_input_count": { "type": "integer", "minimum": 0, "maximum": 9 },
              "rating": { "enum": ["Top", "High", "Medium", "Low"] },
              "core_weakness": { "type": "boolean" },
              "data_status": { "enum": ["fixture", "observed", "modelled", "mixed"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 100 }
  }
}
