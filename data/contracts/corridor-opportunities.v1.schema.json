{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://velocity.local/contracts/corridor-opportunities.v1.schema.json",
  "title": "VeloCity Member C opportunity profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "generatedAt", "evidenceArtifactId", "scenarioModel", "portfolio", "records"],
  "properties": {
    "schemaVersion": { "const": "velocity.corridor-opportunities.v1" },
    "artifactId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "evidenceArtifactId": { "type": "string", "minLength": 1 },
    "scenarioModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "nature", "generatedFrom", "metricDefinitions", "assumptions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "nature": { "const": "synthetic-fallback" },
        "generatedFrom": { "const": "velocity.corridor-demand.v2" },
        "metricDefinitions": {
          "type": "object", "additionalProperties": false,
          "required": ["lowStressTrips", "populationConnected", "destinationsReached", "dangerousSegments"],
          "properties": {
            "lowStressTrips": { "$ref": "#/definitions/metricDefinition" },
            "populationConnected": { "$ref": "#/definitions/metricDefinition" },
            "destinationsReached": { "$ref": "#/definitions/metricDefinition" },
            "dangerousSegments": { "$ref": "#/definitions/metricDefinition" }
          }
        },
        "assumptions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "disclaimer", "years"],
      "properties": {
        "strategy": { "const": "illustrative-evidence-priority-order" },
        "disclaimer": { "type": "string", "minLength": 1 },
        "years": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["year", "corridorIds"],
            "properties": {
              "year": { "enum": [1, 2, 3] },
              "corridorIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/opportunity" }
    }
  },
  "definitions": {
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "metricDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "betterDirection"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "betterDirection": { "enum": ["higher", "lower"] }
      }
    },
    "scoreInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safety", "connectivity", "equity", "currentDemand", "potentialDemand", "transit", "barriers", "coverage", "destinations"],
      "properties": {
        "safety": { "$ref": "#/definitions/score" }, "connectivity": { "$ref": "#/definitions/score" },
        "equity": { "$ref": "#/definitions/score" }, "currentDemand": { "$ref": "#/definitions/score" },
        "potentialDemand": { "$ref": "#/definitions/score" }, "transit": { "$ref": "#/definitions/score" },
        "barriers": { "$ref": "#/definitions/score" }, "coverage": { "$ref": "#/definitions/score" },
        "destinations": { "$ref": "#/definitions/score" }
      }
    },
    "geometry": { "type": "object", "additionalProperties": false, "required": ["type", "coordinates"], "properties": { "type": { "enum": ["LineString", "MultiLineString"] }, "coordinates": { "type": "array", "minItems": 1 } } },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lowStressTrips", "populationConnected", "destinationsReached", "dangerousSegments"],
      "properties": {
        "lowStressTrips": { "type": "integer", "minimum": 0 },
        "populationConnected": { "type": "integer", "minimum": 0 },
        "destinationsReached": { "type": "integer", "minimum": 0 },
        "dangerousSegments": { "type": "integer", "minimum": 0 }
      }
    },
    "deltaMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lowStressTrips", "populationConnected", "destinationsReached", "dangerousSegments"],
      "properties": {
        "lowStressTrips": { "type": "integer" },
        "populationConnected": { "type": "integer" },
        "destinationsReached": { "type": "integer" },
        "dangerousSegments": { "type": "integer" }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corridorId", "name", "subtitle", "sourceStatus", "geometry", "evidence", "priority", "comparison"],
      "properties": {
        "corridorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "sourceStatus": { "type": "string", "minLength": 1 },
        "geometry": { "$ref": "#/definitions/geometry" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "inputScores", "rawFeatures", "prediction", "observation", "sourceProvenance", "modelBeatBaseline", "modelValidation"],
          "properties": {
            "status": { "const": "trained-artifact" },
            "inputScores": { "$ref": "#/definitions/scoreInputs" },
            "rawFeatures": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["number", "null"] } },
            "prediction": {
              "type": "object", "additionalProperties": false,
              "required": ["relativeBicyclesPerObservedHour", "uncertainty"],
              "properties": {
                "relativeBicyclesPerObservedHour": { "type": "number", "minimum": 0 },
                "uncertainty": {
                  "type": "object", "additionalProperties": false,
                  "required": ["lower", "upper", "level", "method"],
                  "properties": {
                    "lower": { "type": "number", "minimum": 0 },
                    "upper": { "type": "number", "minimum": 0 },
                    "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
                    "method": { "enum": ["spatial-holdout-residual-quantile", "bootstrap"] }
                  }
                }
              }
            },
            "observation": {
              "type": "object", "additionalProperties": false,
              "required": ["start", "end"],
              "properties": { "start": { "type": "string", "format": "date" }, "end": { "type": "string", "format": "date" } }
            },
            "sourceProvenance": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "modelBeatBaseline": { "type": "boolean" },
            "modelValidation": {
              "type": "object", "additionalProperties": false,
              "required": ["metric", "modelValue", "medianBaselineValue"],
              "properties": {
                "metric": { "enum": ["mae", "rmse"] },
                "modelValue": { "type": "number", "minimum": 0 },
                "medianBaselineValue": { "type": "number", "minimum": 0 }
              }
            }
          }
        },
        "priority": {
          "type": "object", "additionalProperties": false,
          "required": ["score", "tier", "strongInputCount", "rank", "rolloutYear"],
          "properties": {
            "score": { "$ref": "#/definitions/score" },
            "tier": { "enum": ["Top", "High", "Medium", "Low"] },
            "strongInputCount": { "type": "integer", "minimum": 0, "maximum": 9 },
            "rank": { "type": "integer", "minimum": 1 },
            "rolloutYear": { "enum": [1, 2, 3] }
          }
        },
        "comparison": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "before", "after", "deltas", "routeAlternatives", "selectedRouteId", "representativeAgents", "networkState", "warnings"],
          "properties": {
            "status": { "const": "synthetic-fallback" },
            "before": { "$ref": "#/definitions/metrics" },
            "after": { "$ref": "#/definitions/metrics" },
            "deltas": { "$ref": "#/definitions/deltaMetrics" },
            "routeAlternatives": {
              "type": "array", "minItems": 2,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "kind", "label", "geometryRef", "geometrySource"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "kind": { "enum": ["existing-condition", "official-candidate-alignment"] },
                  "label": { "type": "string", "minLength": 1 },
                  "geometryRef": { "enum": ["record.geometry", null] },
                  "geometrySource": { "enum": ["none", "cycling-program-2025-2027"] }
                }
              }
            },
            "selectedRouteId": { "type": "string", "minLength": 1 },
            "representativeAgents": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "weight", "weightUnit", "origin", "destination", "beforeRouteId", "afterRouteId"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "weight": { "type": "integer", "minimum": 1 },
                  "weightUnit": { "const": "simulated-low-stress-trips-per-weekday" },
                  "origin": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                  "destination": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                  "beforeRouteId": { "type": "null" },
                  "afterRouteId": { "type": "string", "minLength": 1 }
                }
              }
            },
            "networkState": {
              "type": "object", "additionalProperties": false,
              "required": ["horizonYear", "beforeActiveCorridorIds", "afterActiveCorridorIds"],
              "properties": {
                "horizonYear": { "enum": [1, 2, 3] },
                "beforeActiveCorridorIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "afterActiveCorridorIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            },
            "warnings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
