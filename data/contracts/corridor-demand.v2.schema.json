{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://velocity.local/contracts/corridor-demand.v2.schema.json",
  "title": "VeloCity Member A demand evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "generatedAt", "model", "records"],
  "properties": {
    "schemaVersion": { "const": "velocity.corridor-demand.v2" },
    "artifactId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "trainedAt", "datasetManifestVersion", "featureVersion", "target", "unit", "normalization", "validation", "productionEligible"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "trainedAt": { "type": "string", "format": "date-time" },
        "datasetManifestVersion": { "type": "string", "minLength": 1 },
        "featureVersion": { "const": "velocity-counter-features.v2" },
        "target": { "const": "relative-bicycles-per-observed-hour" },
        "unit": { "const": "dimensionless-relative-hourly-demand" },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["referenceBicyclesPerHour", "fittedOn"],
          "properties": {
            "referenceBicyclesPerHour": { "type": "number", "exclusiveMinimum": 0 },
            "fittedOn": { "const": "training-only" }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "grouping", "metric", "modelValue", "medianBaselineValue", "baseline", "lowerIsBetter", "trainGroupIds", "testGroupIds"],
          "properties": {
            "strategy": { "const": "spatial-holdout" },
            "grouping": { "enum": ["counter-site", "corridor"] },
            "metric": { "enum": ["mae", "rmse"] },
            "modelValue": { "type": "number", "minimum": 0 },
            "medianBaselineValue": { "type": "number", "minimum": 0 },
            "baseline": { "const": "training-median" },
            "lowerIsBetter": { "const": true },
            "trainGroupIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "testGroupIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "productionEligible": { "type": "boolean" }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["corridorId", "inputScores", "rawFeatures", "prediction", "observation", "sourceProvenance"],
        "properties": {
          "corridorId": { "type": "string", "minLength": 1 },
          "geometry": { "type": ["object", "null"] },
          "inputScores": { "$ref": "#/$defs/scoreInputs" },
          "rawFeatures": { "type": "object", "additionalProperties": { "type": ["number", "null"] } },
          "prediction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relativeBicyclesPerObservedHour", "uncertainty"],
            "properties": {
              "relativeBicyclesPerObservedHour": { "type": "number", "minimum": 0 },
              "uncertainty": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lower", "upper", "level", "method"],
                "properties": {
                  "lower": { "type": "number", "minimum": 0 },
                  "upper": { "type": "number", "minimum": 0 },
                  "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
                  "method": { "enum": ["spatial-holdout-residual-quantile", "bootstrap"] }
                }
              }
            }
          },
          "observation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": { "start": { "type": "string", "format": "date" }, "end": { "type": "string", "format": "date" } }
          },
          "sourceProvenance": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "scoreInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safety", "connectivity", "equity", "currentDemand", "potentialDemand", "transit", "barriers", "coverage", "destinations"],
      "properties": {
        "safety": { "$ref": "#/$defs/score" }, "connectivity": { "$ref": "#/$defs/score" },
        "equity": { "$ref": "#/$defs/score" }, "currentDemand": { "$ref": "#/$defs/score" },
        "potentialDemand": { "$ref": "#/$defs/score" }, "transit": { "$ref": "#/$defs/score" },
        "barriers": { "$ref": "#/$defs/score" }, "coverage": { "$ref": "#/$defs/score" },
        "destinations": { "$ref": "#/$defs/score" }
      }
    }
  }
}
